<%- include('../partials/service-head', { pageTitle: 'Health Insurance' }) %>

<div class="svc-wrapper">

  <div class="svc-back-bar">
    <a href="/" class="svc-back-btn">&#8592;</a>
    <div>
      <div class="svc-back-title">Health Insurance</div>
      <div class="svc-back-sub">Star Health & Care Plans</div>
    </div>
  </div>

  <div class="svc-hero">
    <div class="svc-hero-icon">🏥</div>
    <h1 class="svc-hero-title">Stay Protected</h1>
    <p class="svc-hero-sub">Health cover starting from just ₹6,000/year</p>
  </div>

  <!-- Price Highlight -->
  <div class="sec-label">Starting Price</div>
  <div class="price-highlight-card">
    <div class="price-big">₹6,000<span>/year</span></div>
    <div class="price-sub">Individual plan · Family floater plans available</div>
  </div>

  <!-- Providers -->
  <div class="sec-label">Available Providers</div>
  <div class="provider-row">
    <div class="provider-chip">⭐ Star Health</div>
    <div class="provider-chip">🏥 Care Insurance</div>
    <div class="provider-chip">🛡️ National Insurance</div>
  </div>

  <!-- Key Benefits -->
  <div class="sec-label">Key Benefits</div>
  <div class="plan-card">
    <div class="plan-name">🌟 What You Get</div>
    <ul class="plan-pts">
      <li>Cashless treatment at 10,000+ network hospitals</li>
      <li>Pre & post hospitalisation expenses covered</li>
      <li>Day care procedures covered </li>
      <li>Road and Air Ambulance charges included</li>
      <li>Tax benefit under Section 80D</li>
      <li>health check-up included</li>
    </ul>
  </div>

  <!-- Plan Comparison -->
  <div class="sec-label">Plan Options</div>
  <div class="plan-card">
    <div class="plan-name">👤 Individual Plan</div>
    <ul class="plan-pts">
      <li>Cover: ₹5L to ₹1 Crore and above</li>
      <li>Starting from ₹6,000/year</li>
      <li>Ideal for working professionals</li>
    </ul>
  </div>
  <div class="plan-card">
    <div class="plan-name">👨‍👩‍👧‍👦 Family Floater Plan</div>
    <ul class="plan-pts">
      <li>Entire family under one policy</li>
      <li>Cover shared among all members</li>
      <li>More affordable than individual plans</li>
    </ul>
  </div>

  <!-- Query -->
  <div class="sec-label">Get a Free Quote</div>
  <div class="query-box">
    <p class="query-title">📩 Health Insurance Query</p>
    <div class="mb-2"><input class="svc-input" id="hi-name"   type="text" placeholder="Your full name *" /></div>
    <div class="mb-2"><input class="svc-input" id="hi-mobile" type="tel"  placeholder="Mobile number *" /></div>
    <div class="mb-2">
      <select class="svc-input" id="hi-provider">
        <option value="Not Sure">Preferred provider</option>
        <option value="Star Health">Star Health</option>
        <option value="Care Insurance">Care Insurance</option>
        <option value="National Insurance">National Insurance</option>
        <option value="Not Sure">Help me choose</option>
      </select>
    </div>
    <div class="mb-2"><input class="svc-input" id="hi-family" type="text" placeholder="Family members & ages (e.g. Self 35, Wife 32, Child 5)" /></div>
    <div class="mb-3"><textarea class="svc-input" id="hi-query" rows="3" placeholder="Your query or requirements *"></textarea></div>
    <div id="hi-error" class="form-err d-none"></div>
    <button class="svc-submit-btn" onclick="submitQuery('hi')">Get Free Quote</button>
  </div>

<%- include('../partials/service-foot') %>
