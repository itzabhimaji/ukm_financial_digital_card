<%- include('../partials/service-head', { pageTitle: 'LIC Insurance' }) %>

<div class="svc-wrapper">

  <!-- Back Bar -->
  <div class="svc-back-bar">
    <a href="/" class="svc-back-btn">&#8592;</a>
    <div>
      <div class="svc-back-title">LIC Insurance</div>
      <div class="svc-back-sub">Life Insurance Corporation of India</div>
    </div>
  </div>

  <!-- Hero -->
  <div class="svc-hero">
    <div class="svc-hero-icon">🛡️</div>
    <h1 class="svc-hero-title">Protect Your Family</h1>
    <p class="svc-hero-sub">Trusted LIC Advisor · 25+ Years Experience</p>
  </div>

  <!-- Recomanded Combined Plan -->
  <div class="sec-label">UKM Spl Combined Plan</div>
  <div class="plan-card">
    <div class="plan-name">🌱 Combined Plan – Secure & Support</div>
    <ul class="plan-pts">
      <li>Life cashflow proposal</li>
      <li>Benefit Covers expenses</li>
      <li>Secures your kids future</li>
      <li>Protects your lagecy</li>
      <li>Builds financial security</li>
    </ul>
  </div>

  <!-- Endowment Plan -->
  <div class="sec-label">Endowment Plan</div>
  <div class="plan-card">
    <div class="plan-name">💰 Endowment Plan – Save & Protect</div>
    <ul class="plan-pts">
      <li>Savings + life protection combined</li>
      <li>Guaranteed lump sum on maturity</li>
      <li>Annual bonus declared by LIC </li>
      <li>Loan facility after 2 years of premium</li>
      <li>Ideal for long-term financial goals</li>
      <li>Tax benefit under Section 80C and 10(10D)</li>
    </ul>
  </div>

  <!-- Whole Life Plan -->
  <div class="sec-label">Whole Life Plan</div>
  <div class="plan-card">
    <div class="plan-name">♾️ Whole Life Plan – Lifelong Cover</div>
    <ul class="plan-pts">
      <li>Limited premium payment term</li>
      <li>Life cover continues up to age 100</li>
      <li>Wealth creation for next generation</li>
      <li>Loan available</li>
      <li>Servival-benifits for Whole Life</li>
      <li>Surrender value available after 2 years</li>
      <li>Reversionary bonus accumulates yearly</li>
    </ul>
  </div>

  <!-- Money Back Plan -->
  <div class="sec-label">Money Back Plan</div>
  <div class="plan-card">
    <div class="plan-name">🔄 Money Back Plan – Regular Returns</div>
    <ul class="plan-pts">
      <li>Periodic survival benefits every 5 years</li>
      <li>Full sum assured paid on maturity</li>
      <li>Life cover till Maturity Date</li>
      <li>Ideal for short to medium-term cash needs</li>
      <li>Maturity Benefit with Assured Sum + Reversionary Bonus + F.A.B.</li>
      <li>Tax-free returns under 8C and 10(10D)</li>
    </ul>
  </div>

  <!-- Children's Plan --> 
  <div class="sec-label">Children's Plan</div> 
  <div class="plan-card"> 
    <div class="plan-name">👶 Children's Plan – Secure Their Future</div> 
    <ul class="plan-pts"> 
      <li>Build a financial corpus for your child</li> 
      <li>Supports education and marriage expenses</li> 
      <li>Life cover for the parent during the policy term</li> 
      <li>Maturity benefit paid at the right stage of life</li> 
      <li>Bonus benefits under participating plans</li> 
      <li>Tax benefits under Section 80C & 10(10D)</li> 
    </ul> 
  </div>

  <!-- Pension Plan --> 
  <div class="sec-label">Pension Plan</div> 
  <div class="plan-card"> 
    <div class="plan-name">👴 Pension Plan – Retire with Confidence</div> 
    <ul class="plan-pts"> 
      <li>Build a regular retirement income</li> 
      <li>Guaranteed pension options available</li> 
      <li>Choose immediate or deferred annuity</li> 
      <li>Financial independence after retirement</li> 
      <li>Life-long income with optional spouse benefits</li> 
      <li>Tax benefits as per applicable income tax laws</li> 
    </ul> 
  </div>

  <!-- Term Plan -->
  <div class="sec-label">Term Policy</div>
  <div class="plan-card">
    <div class="plan-name">📋 Term Plan – Pure Life Cover</div>
    <ul class="plan-pts">
      <li>Pure protection at the lowest premium</li>
      <li>Life cover up to ₹5 Crore and above</li>
      <li>Policy term from 10 to 40 years</li>
      <li>Death benefit paid to nominee tax-free</li>
      <li>Tax benefit under Section 80C & 10(10D)</li>
      <li>Rider options: Accidental, Critical Illness</li>
    </ul>
  </div>

  <!-- ULIP Plan --> 
  <div class="sec-label">ULIP Plan</div> 
  <div class="plan-card"> 
    <div class="plan-name">📈 ULIP Plan – Invest & Protect</div> 
    <ul class="plan-pts"> 
      <li>Life insurance with market-linked returns</li> 
      <li>Choose equity, debt, or balanced funds</li> 
      <li>Switch funds as per your financial goals</li> 
      <li>Long-term wealth creation potential</li> 
      <li>Life cover throughout the policy term</li> 
      <li>Tax benefits under Section 80C & 10(10D)</li> 
    </ul> 
  </div>

  <!-- Register Link -->
  <div class="sec-label">Start Investing</div>
  <div class="invest-link-box">
    <p class="invest-link-title">🔗 Register & Invest Directly</p>
    <p class="invest-link-sub">Start your journey towards financial security with LIC. Register now and get personalized insurance guidance from Uttam Kumar Maji.</p>
    <a href="https://www.india.com" target="_blank" class="invest-link-btn mt-2">Register on LIC ↗</a>
  </div>

  <!-- Query Section -->
  <div class="sec-label">Ask a Query</div>
  <div class="query-box">
    <p class="query-title">📩 Insurance Query</p>

    <div class="mb-2">
      <input class="svc-input" id="lic-name" type="text" placeholder="Your full name *" />
    </div>
    <div class="mb-2">
      <input class="svc-input" id="lic-mobile" type="tel" placeholder="Mobile number *" />
    </div>
    <div class="mb-2">
      <select class="svc-input" id="lic-plan">
        <option value="">Select plan type</option>
        <option value="UKM SPL Combined Plan">UKM SPL Combined Plan</option>
        <option value="Endowment Plan">Endowment Plan</option>
        <option value="Whole Life Plan">Whole Life Plan</option>
        <option value="Money Back Plan">Money Back Plan</option>
        <option value="Pension Plan">Pension Plan</option>
        <option value="Children Plan">Children Plan</option>
        <option value="ULIP Plan">ULIP Plan</option>
        <option value="Term Plan">Term Plan</option>
        <option value="Other">Other / Not Sure</option>
        <option value="Not Sure">Help me choose</option>
      </select>
    </div>
    <div class="mb-3">
      <textarea class="svc-input" id="lic-query" rows="3" placeholder="Write your query here *"></textarea>
    </div>

    <div id="lic-error" class="form-err d-none"></div>
    <button class="svc-submit-btn" onclick="submitQuery('lic')">Submit Query</button>
  </div>

<%- include('../partials/service-foot') %>
